# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# After verifying your domain in Resend, replace this with your own address.
# Until then, Resend only allows sending to the email you signed up with.
INVITE_FROM_EMAIL=Content Hub <you@yourdomain.com>

# Your Vercel deployment URL (set automatically by Vercel, override if needed)
APP_URL=https://your-app.vercel.app
